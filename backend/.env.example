NODE_ENV=development
PORT=3000
# Your single purchased domain (PDF §2). Dev: use "localhost" -> kavya.localhost:4200
PLATFORM_DOMAIN=localhost
# Custom domains must CNAME to this host (PDF §2)
CNAME_TARGET=stores.myshop.com
# Public IP of the server (apex custom domains can use an A record instead of CNAME)
SERVER_IP=
PUBLIC_SCHEME=http
FRONTEND_PORT=4200

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=myshop
DB_PASSWORD=Ramesh@1045
DB_NAME=myshop
DB_POOL_MAX=20

REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# 32-byte key, base64 (openssl rand -base64 32) - encrypts client Razorpay secrets
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Caddy on-demand TLS "ask" endpoint shared secret
INTERNAL_SECRET=change-me-internal

# Platform billing - YOUR Razorpay account (PDF §11)
PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=
PLATFORM_RAZORPAY_WEBHOOK_SECRET=

# S3-compatible object storage + CDN (PDF §11). Leave S3_BUCKET empty to use local ./uploads in dev
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
CDN_BASE_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MyShop <no-reply@myshop.com>"
