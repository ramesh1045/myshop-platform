# Copy to deploy/.env on the server and fill in
PLATFORM_DOMAIN=myshop.com
CNAME_TARGET=stores.myshop.com
SERVER_IP=203.0.113.10
ACME_EMAIL=you@myshop.com
# Cloudflare API token with Zone:DNS:Edit for myshop.com (wildcard certificate)
CLOUDFLARE_API_TOKEN=

MYSQL_ROOT_PASSWORD=change-me-root
DB_USER=myshop
DB_PASSWORD=change-me-db
DB_NAME=myshop

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (exactly 32 bytes)
ENCRYPTION_KEY=
# openssl rand -hex 16
INTERNAL_SECRET=

PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=
PLATFORM_RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 / AWS S3 / DigitalOcean Spaces
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=myshop-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
CDN_BASE_URL=https://cdn.myshop.com

SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MyShop <no-reply@myshop.com>
