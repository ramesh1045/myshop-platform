# 1) build the single Angular app
FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ARG PLATFORM_DOMAIN=myshop.com
RUN sed -i "s/platformDomain: '.*'/platformDomain: '${PLATFORM_DOMAIN}'/" src/environments/environment.prod.ts \
 && npx ng build --configuration production

# 2) Caddy with the Cloudflare DNS plugin (needed for the *.myshop.com wildcard certificate)
FROM caddy:2.10-builder AS caddybuild
RUN xcaddy build --with github.com/caddy-dns/cloudflare

FROM caddy:2.10-alpine
COPY --from=caddybuild /usr/bin/caddy /usr/bin/caddy
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=web /web/dist/frontend/browser /srv/web
